<style is:global>
  /* Custom elements default to inline. Block is required for width, margins, etc.
     Placed in @layer components so Tailwind utilities (e.g. inline-flex on spinbuttons) still win. */
  @layer components {
    cinq-accordion,
    cinq-calendar,
    cinq-combobox,
    cinq-windowsplitter,
    cinq-disclosure-button,
    cinq-switch,
    cinq-spinbutton,
    cinq-slider,
    cinq-slider-range,
    cinq-modal,
    cinq-modal-button,
    cinq-drawer,
    cinq-drawer-button,
    cinq-tabs {
      display: block;
    }
    cinq-pixelate,
    cinq-dual-scroll {
      display: block;
    }
  }
</style>

<script>
  import '@agencecinq/tabs';
  import '@agencecinq/modal';
  import '@agencecinq/drawer';
  import '@agencecinq/spinbutton';
  import '@agencecinq/slider';
  import '@agencecinq/disclosure-button';
  import '@agencecinq/switch';
  import '@agencecinq/accordion';
  import '@agencecinq/combobox';
  import '@agencecinq/windowsplitter';
  import '@agencecinq/calendar';
  import '@agencecinq/pixelate';
  import '@agencecinq/dual-scroll';
</script>

